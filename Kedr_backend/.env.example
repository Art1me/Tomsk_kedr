# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,123.123.123.123

# Frontend domains allowed to call backend
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Djoser links in emails
DJOSER_PASSWORD_RESET_CONFIRM_URL=password-reset/{uid}/{token}/
DJOSER_EMAIL_FRONTEND_URL=https://example.com/api/users/activate/{uid}/{token}/

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/
YOOKASSA_WEBHOOK_TOKEN=
YOOKASSA_DEFAULT_AMOUNT=300.00
